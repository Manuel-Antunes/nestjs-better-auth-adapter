{
	"name": "nestjs-better-auth-adapter-example",
	"version": "0.0.0",
	"private": true,
	"description": "A real-world NestJS API on Better Auth, using every feature of nestjs-better-auth-adapter",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "nest build",
		"start": "node --env-file-if-exists=.env dist/main.js",
		"start:dev": "nest start --watch --env-file .env",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "npx auth@latest generate --config src/auth/auth.ts --output src/database/schema/auth-schema.ts --yes",
		"test": "bun run test:express && bun run test:fastify",
		"test:express": "HTTP_ADAPTER=express vitest run",
		"test:fastify": "HTTP_ADAPTER=fastify vitest run"
	},
	"dependencies": {
		"@apollo/server": "^5.5.2",
		"@as-integrations/express5": "^1.1.2",
		"@as-integrations/fastify": "^3.1.0",
		"@better-auth/api-key": "1.7.25",
		"@better-auth/redis-storage": "1.7.25",
		"@fastify/helmet": "^13.2.0",
		"@nestjs/apollo": "^14.2.1",
		"@nestjs/authentication": "0.1.6",
		"@nestjs/authorization": "0.1.4",
		"@nestjs/common": "^12.5.1",
		"@nestjs/core": "^12.5.1",
		"@nestjs/drizzle": "0.0.2",
		"@nestjs/event-emitter": "^12.0.3",
		"@nestjs/graphql": "^14.2.1",
		"@nestjs/platform-express": "^12.5.1",
		"@nestjs/platform-fastify": "^12.5.1",
		"@nestjs/platform-socket.io": "^12.5.1",
		"@nestjs/websockets": "^12.5.1",
		"better-auth": "1.7.25",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"drizzle-orm": "^0.45.4",
		"express": "^5.1.0",
		"fastify": "^5.12.8",
		"graphql": "^16.11.0",
		"helmet": "^8.3.0",
		"ioredis": "^5",
		"nestjs-better-auth-adapter": "file:..",
		"nestjs-cls": "7.0.2",
		"nodemailer": "^10.6.0",
		"pg": "^8.23.1",
		"qs": "^6.14.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.13",
		"@nestjs/testing": "^12.5.1",
		"@swc/core": "^1.16.22",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.15.5",
		"@types/supertest": "^7.2.1",
		"drizzle-kit": "^0.31.11",
		"socket.io-client": "^4.8.4",
		"supertest": "^7.3.2",
		"typescript": "^6",
		"unplugin-swc": "^2.0.0",
		"vitest": "^3.2.4"
	}
}
