NODE_ENV=development
PORT=3000
# express | fastify: the app runs on both.
HTTP_ADAPTER=express
APP_NAME=Acme
# The frontend: links in emails point there, and it is a trusted origin.
APP_URL=http://localhost:5173

DATABASE_URL=postgres://acme:acme@localhost:5433/acme
# Better Auth's secondary storage (sessions, rate limits), from docker-compose.yml.
REDIS_URL=redis://localhost:6380

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. CORS is enabled for these origins, with credentials.
TRUSTED_ORIGINS=http://localhost:5173

# Mailpit, from docker-compose.yml.
SMTP_URL=smtp://localhost:1026
MAIL_FROM="Acme <no-reply@acme.test>"

# scrypt cost of Nest's PasswordHasher (log2 N). 17 is the OWASP minimum.
PASSWORD_HASH_LOG_N=17

# Optional: social sign-in. Leave empty to disable a provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared with the payment provider, to sign billing webhooks.
BILLING_WEBHOOK_SECRET=change-me-billing-webhook-secret
