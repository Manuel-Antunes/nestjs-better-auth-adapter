NODE_ENV=test
APP_NAME=Acme
APP_URL=http://localhost:5173
DATABASE_URL=postgres://acme:acme@localhost:5433/acme_test
# A Redis database of the tests' own: the setup flushes it.
REDIS_URL=redis://localhost:6380/1
BETTER_AUTH_SECRET=test-secret-test-secret-test-secret-1234
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173
SMTP_URL=smtp://localhost:1026
MAIL_FROM="Acme <no-reply@acme.test>"
# The lowest cost Nest's PasswordHasher accepts: suites hash many passwords.
PASSWORD_HASH_LOG_N=10
BILLING_WEBHOOK_SECRET=test-billing-webhook-secret
